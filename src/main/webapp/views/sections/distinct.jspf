<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="fn" uri="http://java.sun.com/jsp/jstl/functions" %>

<!-- =================================================
     DISTINCT SECTION
================================================= -->
<section class="distinct-section">

    <!-- Section Intro -->
    <div class="distinct-intro">
        <c:if test="${not empty sec.title}">
            <h2><c:out value="${sec.title}" /></h2>
        </c:if>

        <c:if test="${not empty sec.content}">
            <p><c:out value="${sec.content}" escapeXml="false" /></p>
        </c:if>
    </div>

    <!-- Cards Grid -->
    <c:forEach var="img" items="${sec.images}" varStatus="status">
        <c:set var="cardTitle" value="${not empty img.heading1 ? img.heading1 : img.altText}" />
        <c:set var="imageUri" value="${pageContext.request.contextPath}/imageStream?id=${img.id}" />

        <div class="distinct-card ${status.first ? 'distinct-card-first' : (status.index == 1 ? 'distinct-card-second' : '')}"
             data-title="${fn:escapeXml(cardTitle)}"
             data-img="${imageUri}"
             data-desc-id="distinct-desc-${img.id}-${status.index}">

            <!-- Card Image -->
            <img src="${imageUri}" alt="${fn:escapeXml(not empty img.altText ? img.altText : sec.title)}">

            <!-- Hover Overlay -->
            <div class="distinct-overlay">
                <div class="distinct-overlay-content">
                    <c:if test="${not empty img.heading1}">
                        <h4 class="image-heading1"><c:out value="${img.heading1}" /></h4>
                    </c:if>

                    <c:if test="${not empty img.heading2}">
                        <h5 class="image-heading2"><c:out value="${img.heading2}" /></h5>
                    </c:if>

                    <c:if test="${not empty img.altText}">
                        <h3><c:out value="${img.altText}" /></h3>
                    </c:if>

                    <span class="distinct-read-more">READ MORE &rightarrow;</span>
                </div>
            </div>

            <!-- Hidden Content for Modal -->
            <div id="distinct-desc-${img.id}-${status.index}" style="display: none;">
                <c:choose>
                    <c:when test="${not empty img.heading2}">
                        <c:out value="${img.heading2}" escapeXml="false" />
                    </c:when>
                    <c:when test="${not empty img.altText}">
                        <c:out value="${img.altText}" />
                    </c:when>
                </c:choose>
            </div>
        </div>
    </c:forEach>

</section>

<!-- =================================================
     DISTINCT POPUP MODAL CONTAINER
================================================= -->
<div id="distinctModalOverlay" class="distinct-modal-overlay">
    <div class="distinct-modal-content" role="dialog" aria-modal="true" aria-labelledby="distinctModalTitle">
        
        <button type="button" class="distinct-modal-close" id="distinctModalClose" aria-label="Close">&times;</button>

        <div class="distinct-modal-body">
            <div class="distinct-modal-left">
                <img id="distinctModalImg" src="" alt="">
            </div>

            <div class="distinct-modal-right">
                <h3 id="distinctModalTitle" class="distinct-modal-title"></h3>
                <div id="distinctModalDesc" class="distinct-modal-desc"></div>
            </div>
        </div>
    </div>
</div>

<!-- =================================================
     MODAL INTERACTION LOGIC
================================================= -->
<script>
document.addEventListener("DOMContentLoaded", function () {
    const modalOverlay = document.getElementById("distinctModalOverlay");
    const modalClose = document.getElementById("distinctModalClose");
    const modalImg = document.getElementById("distinctModalImg");
    const modalTitle = document.getElementById("distinctModalTitle");
    const modalDesc = document.getElementById("distinctModalDesc");

    document.querySelectorAll(".distinct-card").forEach(card => {
        card.addEventListener("click", function () {
            const title = this.dataset.title || "";
            const imgSrc = this.dataset.img || "";
            const descTargetId = this.dataset.descId;

            modalTitle.textContent = title;
            modalImg.src = imgSrc;
            modalImg.alt = title;

            let rawContent = "";
            if (descTargetId) {
                const contentContainer = document.getElementById(descTargetId);
                if (contentContainer) {
                    rawContent = contentContainer.innerHTML.trim();
                }
            }

            if (rawContent !== "") {
                modalDesc.innerHTML = /<[a-z][\s\S]*>/i.test(rawContent) 
                    ? rawContent 
                    : rawContent.replace(/\r?\n/g, '<br><br>');
            } else {
                modalDesc.innerHTML = "<p>No description available.</p>";
            }

            modalOverlay.classList.add("active");
            document.body.style.overflow = "hidden";
        });
    });

    function closeModal() {
        modalOverlay.classList.remove("active");
        document.body.style.overflow = "auto";
    }

    if (modalClose) modalClose.addEventListener("click", closeModal);

    if (modalOverlay) {
        modalOverlay.addEventListener("click", function (e) {
            if (e.target === modalOverlay) closeModal();
        });
    }

    document.addEventListener("keydown", function(e) {
        if (e.key === "Escape" && modalOverlay.classList.contains("active")) {
            closeModal();
        }
    });
});
</script>